# Copy to .env and fill in. Never commit .env.
# Speech-to-text provider:
#   "auto" (default): Groq if GROQ_API_KEY is set, else local Whisper on this Mac, else mock (demo, flagged).
#   "groq" (cloud), "local" (MLX Whisper on this Mac, no key), or "mock" (demo data only).
TRANSCRIPTION_PROVIDER=auto
GROQ_API_KEY=
# Optional: Groq Whisper model (default whisper-large-v3)
GROQ_STT_MODEL=whisper-large-v3
# Optional: port the browser page uses to reach the backend
MEDSCRIBE_BACKEND_PORT=8770
# AI note writing (transcript -> case paper).
# "auto" (default): Groq if GROQ_API_KEY is set, otherwise Ollama running on this Mac (no key).
# "groq", "ollama" to force one, or "off" (the page then uses its built-in rule-based builder).
NOTE_PROVIDER=auto
# Optional: Groq chat model for notes (default llama-3.3-70b-versatile)
GROQ_NOTE_MODEL=llama-3.3-70b-versatile
# Local AI via Ollama (no key, nothing leaves the Mac)
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_NOTE_MODEL=llama3.1:8b
# Local Whisper model (Hugging Face repo, MLX format; downloaded once, ~1.6 GB)
LOCAL_WHISPER_MODEL=mlx-community/whisper-large-v3-turbo
